# ---------- Application ----------
APP_NAME=SISWA
APP_ENV=development
APP_PORT=3069

# ---------- PostgreSQL ----------
# Use "postgres" as host when running through docker-compose, "localhost" otherwise.
DB_HOST=localhost
DB_PORT=5432
DB_USER=siswa
DB_PASSWORD=siswa_secret
DB_NAME=siswa
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ---------- Redis (realtime request log stream) ----------
# Use "redis:6379" when running through docker-compose.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Request logging ----------
# Request logs are streamed to Redis (realtime) and persisted to PostgreSQL.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_TO_REDIS=true
REQUEST_LOG_TO_DB=true
REQUEST_LOG_MAX_ENTRIES=1000
REQUEST_LOG_PAYLOAD_LIMIT=2048

# ---------- Stock mutation log (console + file) ----------
LOG_LEVEL=info
STOCK_LOG_FILE=logs/stock_mutation.log

# ---------- Seeder ----------
SEED_ENABLED=true
SEED_ITEM_COUNT=1000

# ---------- CORS ----------
CORS_ALLOW_ORIGINS=http://localhost:4069,http://127.0.0.1:4069
